{
  "name": "experience-coffee",
  "version": "1.0.0",
  "private": true,
  "description": "Experience Coffee storefront, subscriptions, and back office (replaces Shopify).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx migration/scripts/import-shopify.ts --snapshot",
    "admin:create": "tsx scripts/create-admin.ts",
    "shopify:export": "tsx migration/scripts/export-shopify.ts",
    "shopify:import": "tsx migration/scripts/import-shopify.ts",
    "images:download": "tsx migration/scripts/download-images.ts",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.38.3",
    "next": "15.3.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^16.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.20.0"
  },
  "engines": {
    "node": ">=20"
  }
}
