# Copy to .env.local for `next dev`, and to .dev.vars for `npm run cf:preview`.
# In production, set each of these as a Cloudflare secret/var (see docs/DEPLOYMENT.md).

# Public URL of the site, no trailing slash
SITE_URL=http://localhost:3000
APP_TIMEZONE=America/New_York

# Neon Postgres. Neon console > your project > Connect > "Pooled connection".
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Long random string (64+ chars). Signs admin and customer sessions + unsubscribe links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# One-time token that unlocks /admin/setup to create the first owner account.
# Remove it after the first owner exists.
SETUP_TOKEN=

# Stripe (use sk_test_/whsec_ test values until launch)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (transactional + marketing email). Domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=Experience Coffee <hello@experiencecoffee.co>

# Shopify migration (only needed to run the export script)
SHOPIFY_STORE_DOMAIN=mesg2c-g0.myshopify.com
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-07
